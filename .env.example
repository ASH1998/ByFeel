# Copy this file to .env and fill in local values. Never commit .env.

# Gemini / Google AI
GOOGLE_API_KEY=
GOOGLE_MODEL=
GOOGLE_MODEL_LITE=
GOOGLE_MODEL_OLD=
GOOGLE_EMBEDDING_MODEL=

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=your-region
FIRESTORE_DATABASE=(default)
EVIDENCE_BUCKET=your-private-evidence-bucket

# Local MVP: "memory" (default) or "firestore" for approved test-data paths only.
BYFEEL_REPOSITORY=memory
BYFEEL_TEST_NAMESPACE=local-mvp
